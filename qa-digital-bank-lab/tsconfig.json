{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "@playwright/test"],
    "moduleResolution": "node"
  },
  "include": ["pages/**/*.ts", "services/**/*.ts", "builders/**/*.ts", "factories/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
